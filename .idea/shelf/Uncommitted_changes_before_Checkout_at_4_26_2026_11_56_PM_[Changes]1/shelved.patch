<+>{% extends \"layout/lecturer_base.html\" %}\r\n\r\n{% block title %}Dashboard Giảng viên{% endblock %}\r\n{% block header_title %}Quản lý khóa học của tôi{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"container-fluid px-0\">\r\n    <div class=\"row g-4 mb-4\">\r\n        <div class=\"col-md-4\">\r\n            <div class=\"card p-4 shadow-sm border-0 bg-dark text-white rounded-4 h-100\">\r\n                <div class=\"d-flex justify-content-between align-items-start\">\r\n                    <div>\r\n                        <small class=\"opacity-75 text-uppercase fw-bold\" style=\"font-size: 11px; letter-spacing: 1px;\">Tổng khóa học</small>\r\n                        <h2 class=\"fw-bold m-0 mt-1\">{{ total_courses }}</h2>\r\n                    </div>\r\n                    <i class=\"bi bi-journal-bookmark fs-3 opacity-50\"></i>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"col-md-4\">\r\n            <div class=\"card p-4 shadow-sm border-0 text-center rounded-4 h-100 bg-white\">\r\n                <div class=\"d-flex justify-content-between align-items-start text-start\">\r\n                    <div>\r\n                        <small class=\"text-muted text-uppercase fw-bold\" style=\"font-size: 11px; letter-spacing: 1px;\">Đang hoạt động</small>\r\n                        <h2 class=\"fw-bold m-0 mt-1 text-success\">{{ active_courses }}</h2>\r\n                    </div>\r\n                    <i class=\"bi bi-check-circle-fill fs-3 text-success opacity-25\"></i>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"col-md-4\">\r\n            <div class=\"card p-4 shadow-sm border-0 text-center rounded-4 h-100 bg-white\">\r\n                <div class=\"d-flex justify-content-between align-items-start text-start\">\r\n                    <div>\r\n                        <small class=\"text-muted text-uppercase fw-bold\" style=\"font-size: 11px; letter-spacing: 1px;\">Học viên theo học</small>\r\n                        <h2 class=\"fw-bold m-0 mt-1\" style=\"color: #111;\">{{ total_students }}</h2>\r\n                    </div>\r\n                    <i class=\"bi bi-people-fill fs-3 opacity-25\"></i>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"card shadow-sm border-0 mb-4 rounded-4\">\r\n        <div class=\"card-body p-3\">\r\n            <form method=\"GET\" action=\"{{ url_for('lecturer_dashboard') }}\" class=\"row g-2\">\r\n                <div class=\"col-md-6\">\r\n                    <div class=\"input-group\">\r\n                        <span class=\"input-group-text bg-white border-end-0 text-muted\"><i class=\"bi bi-search\"></i></span>\r\n                        <input type=\"text\" name=\"kw\" class=\"form-control border-start-0 ps-0\"\r\n                               placeholder=\"Tìm tên khóa học của bạn...\" value=\"{{ request.args.get('kw', '') }}\">\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-md-3\">\r\n                    <select name=\"status\" class=\"form-select\" onchange=\"this.form.submit()\">\r\n                        <option value=\"\">Tất cả trạng thái</option>\r\n                        {% for s in CourseStatus %}\r\n                        <option value=\"{{ s.value }}\" {% if request.args.get('status') == s.value %}selected{% endif %}>\r\n                            {{ s.value.capitalize() }}\r\n                        </option>\r\n                        {% endfor %}\r\n                    </select>\r\n                </div>\r\n                <div class=\"col-md-3\">\r\n                    <div class=\"d-flex gap-2\">\r\n                        <button class=\"btn btn-dark w-100\" type=\"submit\">Lọc</button>\r\n                        <a href=\"{{ url_for('lecturer_dashboard') }}\" class=\"btn btn-outline-secondary\" title=\"Xóa lọc\">\r\n                            <i class=\"bi bi-arrow-clockwise\"></i>\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </form>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"card shadow-sm border-0 rounded-4 overflow-hidden bg-white\">\r\n        <div class=\"card-header bg-white py-3 border-0\">\r\n            <div class=\"d-flex justify-content-between align-items-center\">\r\n                <h6 class=\"fw-bold m-0\"><i class=\"bi bi-list-ul me-2\"></i>Danh sách bài giảng</h6>\r\n                <a href=\"{{ url_for('create_course') }}\" class=\"btn btn-sm btn-dark px-3 rounded-pill\">\r\n                    <i class=\"bi bi-plus-lg me-1\"></i> Tạo khóa mới\r\n                </a>\r\n            </div>\r\n        </div>\r\n        <div class=\"table-responsive\">\r\n            <table class=\"table table-hover align-middle mb-0\">\r\n                <thead class=\"table-light\">\r\n                    <tr style=\"font-size: 13px; color: #666;\">\r\n                        <th class=\"ps-4 py-3 border-0\">THÔNG TIN KHÓA HỌC</th>\r\n                        <th class=\"border-0\">DANH MỤC</th>\r\n                        <th class=\"border-0\">HỌC VIÊN</th>\r\n                        <th class=\"border-0\">TRẠNG THÁI</th>\r\n                        <th class=\"text-end pe-4 border-0\">THAO TÁC</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    {% for course in pagination.items %}\r\n                    <tr>\r\n                        <td class=\"ps-4 py-3\">\r\n                            <div class=\"d-flex align-items-center\">\r\n                                <div class=\"me-3\" style=\"width: 80px; height: 50px;\">\r\n                                    <img src=\"{{ course.image }}\" alt=\"Thumb\"\r\n                                         class=\"img-fluid rounded shadow-sm border\"\r\n                                         style=\"width: 100%; height: 100%; object-fit: cover;\"\r\n                                         onerror=\"this.src='https://placehold.co/80x50?text=No+Img'\">\r\n                                </div>\r\n                                <div>\r\n                                    <div class=\"fw-bold text-dark mb-1\">{{ course.title }}</div>\r\n                                    <div class=\"text-muted\" style=\"font-size: 12px;\">\r\n                                        <i class=\"bi bi-layers me-1\"></i>{{ course.sections|length }} chương •\r\n                                        <i class=\"bi bi-calendar3 me-1\"></i>{{ course.created_date.strftime('%d/%m/%Y') }}\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </td>\r\n                        <td>\r\n                            <span class=\"badge bg-light text-dark border-0 fw-normal px-2 py-1\">{{ course.category.name }}</span>\r\n                        </td>\r\n                        <td>\r\n                            <div class=\"text-dark small\"><i class=\"bi bi-people me-1\"></i>{{ course.enrollments|length }}</div>\r\n                        </td>\r\n                        <td>\r\n                            {% if course.status.value == 'active' %}\r\n                                <span class=\"badge bg-success-subtle text-success border-0 px-3 py-1 rounded-pill\">Hoạt động</span>\r\n                            {% elif course.status.value == 'pending' %}\r\n                                <span class=\"badge bg-warning-subtle text-warning border-0 px-3 py-1 rounded-pill\">Chờ duyệt</span>\r\n                            {% else %}\r\n                                <span class=\"badge bg-secondary-subtle text-secondary border-0 px-3 py-1 rounded-pill\">Nháp</span>\r\n                            {% endif %}\r\n                        </td>\r\n                        <td class=\"text-end pe-4\">\r\n                            <div class=\"d-flex justify-content-end gap-2\">\r\n                                {% if course.status.value == 'draft' %}\r\n                                <form action=\"{{ url_for('submit_course', course_id=course.id) }}\" method=\"POST\" class=\"m-0\">\r\n                                    <button type=\"submit\" class=\"btn btn-outline-primary btn-sm rounded-3\"\r\n                                            style=\"width: 34px; height: 34px;\" title=\"Gửi duyệt\"\r\n                                            onclick=\"return confirm('Gửi duyệt khóa học này?')\">\r\n                                        <i class=\"bi bi-send\"></i>\r\n                                    </button>\r\n                                </form>\r\n                                {% endif %}\r\n\r\n                                <a href=\"{{ url_for('manage_course', course_id=course.id) }}\"\r\n                                   class=\"btn btn-outline-dark btn-sm rounded-3 d-flex align-items-center justify-content-center\"\r\n                                   style=\"width: 34px; height: 34px;\" title=\"Quản lý nội dung\">\r\n                                    <i class=\"bi bi-pencil-square\"></i>\r\n                                </a>\r\n\r\n                                <form action=\"{{ url_for('delete_course', course_id=course.id) }}\" method=\"POST\" class=\"m-0\">\r\n                                    <button type=\"submit\" class=\"btn btn-outline-danger btn-sm rounded-3\"\r\n                                            style=\"width: 34px; height: 34px;\" title=\"Xóa\"\r\n                                            onclick=\"return confirm('Xóa vĩnh viễn khóa học này?')\">\r\n                                        <i class=\"bi bi-trash3\"></i>\r\n                                    </button>\r\n                                </form>\r\n                            </div>\r\n                        </td>\r\n                    </tr>\r\n                    {% else %}\r\n                    <tr>\r\n                        <td colspan=\"5\" class=\"text-center py-5 text-muted\">\r\n                            <i class=\"bi bi-inbox fs-2 d-block mb-2\"></i>\r\n                            Chưa có khóa học nào. <a href=\"{{ url_for('create_course') }}\" class=\"fw-bold text-dark\">Tạo ngay khóa đầu tiên!</a>\r\n                        </td>\r\n                    </tr>\r\n                    {% endfor %}\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n\r\n        {% if pagination.pages > 1 %}\r\n        <div class=\"p-3 border-top d-flex justify-content-center\">\r\n            <nav>\r\n                <ul class=\"pagination pagination-sm mb-0\">\r\n                    {% for page_num in pagination.iter_pages() %}\r\n                        {% if page_num %}\r\n                            <li class=\"page-item {% if page_num == pagination.page %}active{% endif %}\">\r\n                                <a class=\"page-link border-0 mx-1 rounded-2\" href=\"{{ url_for('lecturer_dashboard', page=page_num, kw=request.args.get('kw'), status=request.args.get('status')) }}\">\r\n                                    {{ page_num }}\r\n                                </a>\r\n                            </li>\r\n                        {% else %}\r\n                            <li class=\"page-item disabled\"><span class=\"page-link border-0\">...</span></li>\r\n                        {% endif %}\r\n                    {% endfor %}\r\n                </ul>\r\n            </nav>\r\n        </div>\r\n        {% endif %}\r\n    </div>\r\n</div>\r\n{% endblock %}
